# Dify web (Next.js) — pin langgenius/dify-web:1.4.3
# CRITICAL: set PORT=3000 explicitly (Railway may inject 8080)

PORT=3000

CONSOLE_API_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}
APP_API_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}

# After custom domain:
# CONSOLE_API_URL=https://dify.ajumrah.com
# APP_API_URL=https://dify.ajumrah.com
