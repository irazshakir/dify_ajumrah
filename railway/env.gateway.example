# Gateway (nginx/caddy) — only service with a public Railway domain
# Values depend on template; typical pattern:

# Public domain attached here: dify.ajumrah.com → gateway service

# Upstreams (private DNS — template may use different var names):
# API_HOST=${{api.RAILWAY_PRIVATE_DOMAIN}}:5001
# WEB_HOST=${{web.RAILWAY_PRIVATE_DOMAIN}}:3000

# Health check path (template): /gateway-health

# After attaching custom domain, ensure all Dify *_API_URL / *_WEB_URL
# env vars on api/worker/web use https://dify.ajumrah.com
