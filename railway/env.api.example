# Dify API service — copy values into Railway (no secrets in git)
# Pin image: langgenius/dify-api:1.4.3

MODE=api
MIGRATION_ENABLED=true
LOG_LEVEL=INFO

# --- Crypto (shared with worker / worker-beat) ---
SECRET_KEY=<openssl rand -hex 32>

# --- Supabase Postgres (direct host, session mode) ---
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=<railway-secret>
DB_DATABASE=postgres

VECTOR_STORE=pgvector
PGVECTOR_HOST=db.xxxxxxxxxxxx.supabase.co
PGVECTOR_PORT=5432
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=<same-as-db>
PGVECTOR_DATABASE=postgres

# --- Redis (Railway reference vars) ---
REDIS_HOST=${{redis.RAILWAY_PRIVATE_DOMAIN}}
REDIS_PORT=6379
REDIS_PASSWORD=${{redis.REDIS_PASSWORD}}
CELERY_BROKER_URL=redis://:${{redis.REDIS_PASSWORD}}@${{redis.RAILWAY_PRIVATE_DOMAIN}}:6379/1

# --- Public URLs (gateway public domain) ---
CONSOLE_API_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}
APP_API_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}
SERVICE_API_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}
CONSOLE_WEB_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}
APP_WEB_URL=https://${{gateway.RAILWAY_PUBLIC_DOMAIN}}
FILES_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:5001

# --- Object storage (Railway bucket) ---
STORAGE_TYPE=s3
S3_ENDPOINT=<bucket-endpoint>
S3_BUCKET_NAME=<bucket-name>
S3_ACCESS_KEY=<railway-secret>
S3_SECRET_KEY=<railway-secret>
S3_REGION=auto
S3_ADDRESS_STYLE=virtual

# --- Sandbox / SSRF / plugins (template private domains) ---
CODE_EXECUTION_ENDPOINT=http://${{sandbox.RAILWAY_PRIVATE_DOMAIN}}:8194
CODE_EXECUTION_API_KEY=${{sandbox.API_KEY}}
SSRF_PROXY_HTTP_URL=http://${{ssrf-proxy.RAILWAY_PRIVATE_DOMAIN}}:3128
SSRF_PROXY_HTTPS_URL=http://${{ssrf-proxy.RAILWAY_PRIVATE_DOMAIN}}:3128
PLUGIN_DAEMON_URL=http://${{plugin-daemon.RAILWAY_PRIVATE_DOMAIN}}:5002
PLUGIN_DAEMON_KEY=<generated-shared-secret>
INNER_API_KEY_FOR_PLUGIN=<must-match-plugin-daemon>

# --- Optional production hardening ---
ALLOW_REGISTER=false
# REDIS_SOCKET_TIMEOUT=60
